# Backend application
SOURCE_CONTEXT_APP_NAME=Source Context Backend
SOURCE_CONTEXT_APP_VERSION=0.1.0
SOURCE_CONTEXT_ENVIRONMENT=development
SOURCE_CONTEXT_DEBUG=false
SOURCE_CONTEXT_LOG_LEVEL=INFO
SOURCE_CONTEXT_API_V1_PREFIX=/api/v1

# Repository management
SOURCE_CONTEXT_REPOSITORY_WORKSPACE_ROOT=workspace-repositories
SOURCE_CONTEXT_SCANNER_MAX_FILE_SIZE_BYTES=1000000
SOURCE_CONTEXT_GIT_COMMAND_TIMEOUT_SECONDS=120
ENV_STATE=dev

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mydb_dev
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

# Neo4j Configuration
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpassword

# Qdrant Vector DB Configuration (QDRANT_API_KEY can be left empty for local development)
QDRANT_API_KEY=

# Redis Configuration
REDIS_USER=myuser
REDIS_PASSWORD=mypassword

# MinIO Object Storage Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
